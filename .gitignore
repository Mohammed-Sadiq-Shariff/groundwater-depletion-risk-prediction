# Keep ONLY the final verified camera-ready submission PDF
paper_revision_v2/*.pdf
!paper_revision_v2/main_submission_v2.pdf

# Scratch, review inputs, and temporary scripts
scratch/
review_inputs/
*.bak
*.bak*
*.orig
*.backup*
*.backup
*.pre_publish_backup
*.tmp
*.temp
fix_main.py
check_predictions.py
test_dashboard_data.py
test_dashboard_load.py
test_data_simple.py
test_predictions.py
validate_app.py
generate_all_predictions.backup.py
app.py

# Internal assistant configuration
AGENTS.md

# IDE and OS files
.vscode/
.idea/
*.code-workspace
Thumbs.db
Desktop.ini
.DS_Store

# Data: Exclude large raw and interim datasets (multi-GB NWDP daily rainfall / raw PDFs)
data/raw/*
!data/raw/.gitkeep
!data/raw/**/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/boundaries/
!data/metadata/

# Models: Exclude large binary model serialization files, preserve lightweight verification CSVs
models/*.joblib
!models/.gitkeep
!models/*.csv

# Reports: Preserve evaluation CSVs and figures, ignore temporary results
reports/figures/*
!reports/figures/.gitkeep
reports/results/*
!reports/results/.gitkeep
